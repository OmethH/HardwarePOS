{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HardwarePOS",
  "version": "0.1.0",
  "identifier": "com.hardwarepos.app",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "node src-tauri/build-sidecar.mjs && npm run dev --prefix frontend",
    "beforeBuildCommand": "node src-tauri/build-sidecar.mjs && npm run build --prefix frontend"
  },
  "app": {
    "windows": [
      {
        "title": "HardwarePOS",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/hardwarepos-backend"
    ],
    "resources": {
      "../backend/migrations/*": "migrations/"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
